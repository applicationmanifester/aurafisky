# Aurafisky Environment Variables
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO VERSION CONTROL

# Firebase Configuration (required for auth, sync, push notifications)
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FCM_VAPID_KEY=your_fcm_vapid_key_here

# Optional: Open-Meteo API base URL (defaults to official API)
# VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Optional: Analytics / Error tracking
# VITE_SENTRY_DSN=
# VITE_GA_MEASUREMENT_ID=# Aurafisky Environment Variables
# Copy this file to .env and fill in your values

# Firebase Configuration
# Get these from: https://console.firebase.google.com/ -> Project Settings -> General
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# FCM VAPID Key for Push Notifications
# Get from: Firebase Console -> Cloud Messaging -> Web Push certificates
VITE_FCM_VAPID_KEY=your_vapid_public_key_here
