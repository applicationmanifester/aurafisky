{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.git/**",
      "**/.*",
      "**/node_modules/**",
      "brace_check.py"
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=604800, must-revalidate"
          }
        ]
      }
    ]
  }
}
