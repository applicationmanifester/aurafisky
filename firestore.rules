rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user owns exactly one document under /users/{uid}
    // (home location, bookmarks, unit preferences, settings sync).
    // Nobody may read or write another user's document, and there is no
    // expiry date — these rules are the permanent policy.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Any future subcollections under a user doc inherit the same owner check.
      match /{document=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
