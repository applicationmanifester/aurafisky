{
  "name": "Aurafisky Live Explorer",
  "short_name": "Aurafisky",
  "description": "Interactive weather map with real-time conditions, forecasts, radar, and soundscapes.",
  "start_url": "./index.html",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "launch_handler": { "client_mode": "navigate-existing" },
  "edge_side_panel": { "preferred_width": 420 },
  "handle_links": "preferred",
  "categories": ["weather", "utilities"],
  "background_color": "#0f172a",
  "theme_color": "#14b8a6",
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Current Location Weather",
      "short_name": "My Location",
      "description": "View weather for current GPS position",
      "url": "./index.html?action=locate"
    },
    {
      "name": "Rain Radar",
      "short_name": "Radar",
      "description": "Open the live rain radar animation",
      "url": "./index.html?action=radar"
    },
    {
      "name": "Ask Aura",
      "short_name": "Ask Aura",
      "description": "Open the Aura weather assistant",
      "url": "./index.html?action=aura"
    }
  ]
}

