{
  "id": "/",
  "name": "Aurafisky — Live Weather & Maps",
  "short_name": "Aurafisky",
  "description": "Explore live weather maps, animated radar, 7-day forecasts, Air Quality Index (AQI), marine swell, and route weather planning.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#0f172a",
  "theme_color": "#14b8a6",
  "orientation": "any",
  "launch_handler": { "client_mode": "navigate-existing" },
  "edge_side_panel": { "preferred_width": 420 },
  "handle_links": "preferred",
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Live Rain Radar",
      "short_name": "Radar",
      "description": "Open the animated rain radar",
      "url": "/?action=radar",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My Location",
      "short_name": "Locate",
      "description": "Show the weather where you are",
      "url": "/?action=locate",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Daily Briefing",
      "short_name": "Briefing",
      "description": "Read today's weather briefing",
      "url": "/?action=briefing",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Ask Aura",
      "short_name": "Ask Aura",
      "description": "Open the Aura weather assistant",
      "url": "/?action=aura",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "categories": ["weather", "utilities"],
  "screenshots": [
    {
      "src": "/screenshots/desktop.png",
      "sizes": "1440x900",
