{
  "name": "aurafisky",
  "version": "20.2.0",
  "type": "module",
  "description": "Aurafisky — Interactive weather maps, radar, forecasts and route weather planning",
  "author": "Aurafisky",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.js",
    "typecheck": "tsc --noEmit",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --win",
    "cap:build": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:sync": "npx cap sync",
    "mcp:start": "cd mcp-server && node index.mjs",
    "mcp:dev": "cd mcp-server && node index.mjs"
  },
  "//browserslist": "The browsers the app is built and tested for. The CSS carries `vh` fallbacks in front of every `dvh` declaration, and `:has()` is only used for progressive refinement, so older browsers get a working layout rather than a broken one.",
  "browserslist": [
    "chrome >= 87",
    "edge >= 87",
    "firefox >= 78",
    "safari >= 14",
    "ios_saf >= 14",
    "samsung >= 14"
  ],
  "build": {
    "appId": "com.aurafisky.app",
    "productName": "Aurafisky",
    "directories": {
      "output": "C:/Users/bharg_4mtuttl/Desktop/BGK_Applications/AI ChatBot/frontend/release-studio/aurafisky-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "icon-512.png"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Aurafisky"
    }
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "dompurify": "^3.1.0",
    "localforage": "^1.10.0",
    "ol": "^10.10.0",
    "ol-mapbox-style": "^12.6.1",
    "omggif": "^1.0.10"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.3.3",
    "terser": "^5.31.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.0",
    "workbox-window": "^7.1.0"
  }
}
