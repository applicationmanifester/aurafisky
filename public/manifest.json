{
  "name": "Aurafisky - Weather & Maps",
  "short_name": "Aurafisky",
  "description": "Explore live weather maps and radar, compare forecasts, and plan around conditions along your route.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#0ea5e9",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Location",
      "short_name": "Search",
      "description": "Search for a location",
      "url": "/?search=true",
      "icons": [{ "src": "/icons/search-96.png", "sizes": "96x96" }]
    },
    {
      "name": "My Bookmarks",
      "short_name": "Bookmarks",
      "description": "View saved locations",
      "url": "/?bookmarks=true",
      "icons": [{ "src": "/icons/bookmark-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Current Location",
      "short_name": "Current",
      "description": "Weather at my location",
      "url": "/?current=true",
      "icons": [{ "src": "/icons/location-96.png", "sizes": "96x96" }]
    }
  ],
  "categories": ["weather", "utilities"],
  "widgets": [
    {
      "name": "Current Weather",
      "short_name": "Weather",
      "description": "Current live conditions and temperature for your location",
      "tag": "weather-widget",
      "template": "widgets/template",
      "data": "widgets/data",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/icon-512.png",
          "sizes": "512x512",
          "label": "Aurafisky Current Weather Widget"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 1800
    }
  ],
  "screenshots": [],
  "prefer_related_applications": false
}
